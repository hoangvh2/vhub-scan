rules_version = '2';

// VHub Trend Scan. The PC is the source of truth; Firestore only carries:
//   /owners/{uid}/snapshot/latest   what the PC last published (written by the PC's service account,
//                                   which bypasses these rules; the phone may only read it)
//   /owners/{uid}/inbox/{eventId}   Keep/Skip/Snooze/... the phone did while away from home
//                                   (phone may only create; the PC applies and deletes them)
// The phone signs in with a custom token the PC mints when pairing, so its uid is the owner's uid.
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function validEvent(d, eventId) {
      return eventId.matches('^[A-Za-z0-9_-]{8,64}$')
        && d.keys().hasAll(['entityId', 'action', 'at'])
        && d.keys().hasOnly(['entityId', 'action', 'days', 'at', 'device'])
        && d.entityId is string && d.entityId.size() > 0 && d.entityId.size() <= 300
        && d.action in ['keep', 'skip', 'snooze', 'trying', 'done', 'reset']
        && (!('days' in d) || (d.days is int && d.days >= 1 && d.days <= 90))
        && d.at is int && d.at > 0
        && (!('device' in d) || (d.device is string && d.device.size() <= 40));
    }

    match /owners/{uid}/snapshot/{doc} {
      allow get: if owner(uid) && doc == 'latest';
    }

    match /owners/{uid}/inbox/{eventId} {
      allow create: if owner(uid) && validEvent(request.resource.data, eventId);
    }
  }
}
