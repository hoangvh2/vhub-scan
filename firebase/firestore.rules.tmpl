rules_version = '2';

// VHub Trend Scan. TEMPLATE: the allowlist is substituted for the double-underscore placeholder in allowed() below at deploy time
// (Terraform: var.allowed_emails; tests and the emulator: firebase/gen-rules.mjs). The result is
// firestore.rules, which is not committed because the list holds personal addresses.
//
// The PC is the source of truth; Firestore only carries:
//   /owners/{o}/snapshot/latest   what the PC last published (written by the PC's service account,
//                                 which bypasses these rules; signed-in people may only read it)
//   /owners/{o}/inbox/{eventId}   Keep/Skip/Snooze/... done on the web or phone while away from the PC
//                                 (people may only create; the PC applies and deletes them)
//   /owners/{o}/settingsInbox/{id} a settings change made on the web or phone (create only). The patch is a JSON
//                                 string; the PC validates every value against its settings catalogue and refuses
//                                 settings marked PC-only (the Claude command, the port) before writing config.json
//   /owners/{o}/runRequests/{day}-{n}  "Quét bằng Gemini" pressed on the web or phone (create only; the cloud scan
//                                 function writes the outcome onto it). Ids are today's day number (Vietnam time) and
//                                 n = 1, 2, ... in order. A request uses one of the day's scans unless it failed, was
//                                 refused, or got no answer within 15 minutes; up to 3 extra ids allow trying again
//                                 after such failures. So the daily limit holds even without the apps. The scans per
//                                 day and the list of ids are substituted for the double-underscore placeholders
//                                 (Terraform: var.cloud_scans_per_day; 0 = switched off).
// Who may read and write: a verified Google account whose address is on the allowlist. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() in [__ALLOWED_EMAILS__];
    }

    function validEvent(d, eventId) {
      return eventId.matches('^[A-Za-z0-9_-]{8,64}$')
        && d.keys().hasAll(['entityId', 'action', 'at'])
        && d.keys().hasOnly(['entityId', 'action', 'days', 'at', 'device'])
        && d.entityId is string && d.entityId.size() > 0 && d.entityId.size() <= 300
        && d.action in ['keep', 'skip', 'snooze', 'trying', 'done', 'reset']
        && (!('days' in d) || (d.days is int && d.days >= 1 && d.days <= 90))
        && d.at is int && d.at > 0
        && (!('device' in d) || (d.device is string && d.device.size() <= 40));
    }

    function validSettings(d, id) {
      return id.matches('^[A-Za-z0-9_-]{8,64}$')
        && d.keys().hasAll(['patch', 'baseRev', 'at'])
        && d.keys().hasOnly(['patch', 'baseRev', 'at', 'device'])
        && d.patch is string && d.patch.size() >= 2 && d.patch.size() <= 20000
        && d.baseRev is string && d.baseRev.size() <= 64
        && d.at is int && d.at > 0
        && (!('device' in d) || (d.device is string && d.device.size() <= 40));
    }

    // Vietnam day number (UTC+7, no daylight saving): the same as scanDay() in packages/pipeline/src/cloud/scanJob.ts.
    function today() {
      return string(int(math.floor((request.time.toMillis() + 25200000) / 86400000)));
    }

    // Whether request {id} uses one of the day's scans: done, or still waiting or running and under 15 minutes old
    // (the same rule as scanUses() in packages/pipeline/src/cloud/scanJob.ts). Failed, refused and stuck ones do not.
    function scanUses(o, id) {
      let r = get(/databases/$(database)/documents/owners/$(o)/runRequests/$(id)).data;
      let s = r.get('status', 'waiting');
      return s == 'done' || (s in ['waiting', 'running'] && r.at > request.time.toMillis() - 900000);
    }

    // How many of today's requests 1..n-1 use a scan (at most 8 ids exist: 5 scans per day + 3 retries).
    function scansUsedBefore(o, n) {
      return (n > 1 && scanUses(o, today() + '-1') ? 1 : 0)
        + (n > 2 && scanUses(o, today() + '-2') ? 1 : 0)
        + (n > 3 && scanUses(o, today() + '-3') ? 1 : 0)
        + (n > 4 && scanUses(o, today() + '-4') ? 1 : 0)
        + (n > 5 && scanUses(o, today() + '-5') ? 1 : 0)
        + (n > 6 && scanUses(o, today() + '-6') ? 1 : 0)
        + (n > 7 && scanUses(o, today() + '-7') ? 1 : 0);
    }

    function validScanRequest(o, d, id) {
      return id in [__SCAN_IDS__]
        && d.keys().hasAll(['at'])
        && d.keys().hasOnly(['at', 'device'])
        && d.at is int && d.at > request.time.toMillis() - 600000 && d.at < request.time.toMillis() + 600000
        && (!('device' in d) || (d.device is string && d.device.size() <= 40))
        && scanSlotFree(o, int(id.split('-')[1]));
    }

    // Ids are taken in order, and a new one only while fewer than the day's scans are used.
    function scanSlotFree(o, n) {
      return n == 1
        || (exists(/databases/$(database)/documents/owners/$(o)/runRequests/$(today() + '-' + string(n - 1)))
            && scansUsedBefore(o, n) < __SCANS_PER_DAY__);
    }

    match /owners/{o}/snapshot/{doc} {
      allow get: if allowed() && doc == 'latest';
    }

    match /owners/{o}/inbox/{eventId} {
      allow create: if allowed() && validEvent(request.resource.data, eventId);
    }

    match /owners/{o}/settingsInbox/{id} {
      allow create: if allowed() && validSettings(request.resource.data, id);
    }

    match /owners/{o}/runRequests/{id} {
      allow get, list: if allowed();
      allow create: if allowed() && validScanRequest(o, request.resource.data, id);
    }
  }
}
