{
  "name": "@vhub/trend-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collect, dedupe, filter, triage and publish idea digests. Runs on the user's PC; Claude CLI is the default analyzer.",
  "bin": { "trend": "dist/cli.js" },
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
