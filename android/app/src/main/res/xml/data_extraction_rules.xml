<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens stay on this phone: nothing is backed up or transferred to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
