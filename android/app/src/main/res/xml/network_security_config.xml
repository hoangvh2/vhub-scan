<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: the app talks to Google (sign-in) and Firebase (Auth, Firestore) and nothing else. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
