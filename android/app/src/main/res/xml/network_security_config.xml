<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is needed for the PC's LAN address, which is an IP that cannot be listed in advance.
     Every request still carries the dashboard token; cloud endpoints are https URLs fixed in code. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
